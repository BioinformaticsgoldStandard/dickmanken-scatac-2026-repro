// Override values for PUMATAC's generated atac_preprocess_rapid.config,
// applied via `nextflow -c atac_preprocess_rapid.config -c
// config/nextflow_override.config run ...` (multiple -c flags merge
// configs, last one wins on conflicts).
//
// Why this file exists: the tutorial's own "2. Edit the .config file"
// section in 2_running_nextflow_pipeline.ipynb shows these edits as
// illustrative code-cell snippets meant to be copied by hand into the
// generated .config file with a text editor - they are not automatically
// applied by running the notebook. Keeping the actual values here instead,
// as a small versioned override file, makes the change explicit,
// reviewable, and automatically applied without manual file editing or
// fragile text substitution into a generated Nextflow/Groovy file.

params {
    global {
        project_name = 'dickmanken-scatac-2026-repro'
        outdir = 'out'
    }
    tools {
        singlecelltoolkit {
            barcode_correction {
                whitelist {
                    // 'atac_revcomp' matches the technology detected in
                    // metadata.tsv for this 10x ATAC v2 sample (see
                    // notebook 1). ATAC v1/v1.1/v2 share the same
                    // barcode whitelist (confirmed via 10x Genomics
                    // documentation).
                    atac_revcomp = '/home/jovyan/work/PUMATAC_dependencies/whitelists/737K-cratac-v1.REVCOMP.txt.gz'
                }
            }
        }
        bwamaptools {
            // mm10 bwa-mem2 index, downloaded from
            // https://resources.aertslab.org/papers/PUMATAC/PUMATAC_dependencies/genomes/mm10_bwamem2/
            bwa_fasta = '/home/jovyan/work/PUMATAC_dependencies/genomes/mm10_bwamem2/genome.fa'
        }
    }
}

process {
    withLabel:compute_resources__bwa_mem {
        // Original value was 'pbs' (VSC-cluster-specific job scheduler),
        // not available in this environment.
        executor = 'local'
    }
}

singularity {
    // Original bind mounts (/lustre1, /staging, ${VSC_SCRATCH}, ...) are
    // specific to the VSC cluster filesystem layout. Everything relevant
    // here (repo files, FASTQ data, PUMATAC_dependencies) lives under
    // /home/jovyan/work.
    runOptions = '--cleanenv -H $PWD -B /home/jovyan/work,${HOME}/.nextflow/assets/'

    // Absolute path: PUMATAC_dependencies lives at the repo root level
    // (/home/jovyan/work/PUMATAC_dependencies), not relative to the
    // notebook's own directory (notebooks/notebooks_PUMATAC/), where
    // Nextflow is actually launched from.
    cacheDir = '/home/jovyan/work/PUMATAC_dependencies/cache'
}
